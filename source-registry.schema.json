{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/global-trade-lead-search/source-registry.schema.json",
  "title": "Global trade source registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "url",
    "canonical_domain",
    "source_type",
    "continent",
    "country",
    "language",
    "origin",
    "origin_page",
    "health_status",
    "http_status",
    "last_checked_at",
    "trust_level"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "canonical_domain": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": [
        "search_engine",
        "b2b_marketplace",
        "yellow_pages",
        "chamber_association",
        "customs_trade",
        "government_trade",
        "trade_directory"
      ]
    },
    "continent": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "language": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "origin": {"const": "dragon-guide"},
    "origin_page": {"type": "string", "format": "uri"},
    "health_status": {"enum": ["discovered", "active", "unavailable", "origin_unavailable", "origin_blocked"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "last_checked_at": {"type": "string", "format": "date"},
    "trust_level": {"enum": ["official", "authoritative", "industry", "platform", "directory", "discovery", "unclassified"]}
  }
}
